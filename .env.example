# MediaTrust Environment Configuration Example
# Copy to .env for local customized configuration

# Application Settings
ENVIRONMENT=development
APP_NAME=MediaTrust
DEBUG=true
PORT=8000
HOST=127.0.0.1
LOG_LEVEL=INFO

# Security & CORS
# In production, specify exact origins e.g. https://mediatrust.local,chrome-extension://...
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,chrome-extension://*
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long

# Database
# Local SQLite default (persisted in database/mediatrust.db)
DATABASE_URL=sqlite:///./mediatrust.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://mediatrust_user:password@localhost:5432/mediatrust_db

# Risk Engine Thresholds (0-100)
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MODERATE=60
RISK_THRESHOLD_HIGH=85

# Video Sampling & Analysis Limits
MAX_VIDEO_DURATION_SECONDS=180
MAX_VIDEO_FILE_SIZE_MB=50
VIDEO_FRAME_SAMPLE_RATE=1.0
# AI-media popup cutoff (85% model score). Higher cutoff reduces false positives but may miss AI media.
VIDEO_AI_ALERT_THRESHOLD=0.85
VIDEO_AI_ALERTS_ENABLED=true
FACE_DEEPFAKE_ALERT_THRESHOLD=0.85
TEXT_THREAT_ALERT_THRESHOLD=0.60
MAX_VIDEO_FRAMES_TO_ANALYZE=15
MIN_VIDEO_FRAMES_FOR_AI_ALERT=10

# Upload & File Limits
MAX_IMAGE_FILE_SIZE_MB=15
UPLOAD_TEMP_DIR=./temp_uploads

# ML Model Paths
IMAGE_MODEL_CHECKPOINT=models/checkpoints/efficientnet_b0_external.pt
TEXT_MODEL_PIPELINE=models/checkpoints/text_classifier_external.joblib

# Optional External Threat Intelligence (Disabled by default, no fake data)
ENABLE_EXTERNAL_THREAT_INTEL=false
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
